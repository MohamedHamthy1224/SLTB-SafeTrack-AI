# ─────────────────────────────────────────────────────────────────
# SLTB SafeTrack AI — Mobile App
# Environment Configuration Template
#
# Copy this file to .env before running the app locally.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ─── API ──────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000/api
EXPO_PUBLIC_API_TIMEOUT=30000

# ─── App ──────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_VERSION=1.0.0

# ─── Feature Flags ────────────────────────────────────────────────
EXPO_PUBLIC_FEATURE_PUSH_NOTIFICATIONS=false
EXPO_PUBLIC_FEATURE_BIOMETRIC_AUTH=false
EXPO_PUBLIC_FEATURE_OFFLINE_MODE=false

# ─── Development ──────────────────────────────────────────────────
# Set to true to use mock data instead of real API calls
EXPO_PUBLIC_USE_MOCK_DATA=true
